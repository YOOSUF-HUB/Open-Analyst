# =============================================================================
# Open Analyst — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=open_analyst
POSTGRES_USER=open_analyst
POSTGRES_PASSWORD=changeme

# Full DSN (overrides individual fields if set)
# DATABASE_URL=postgresql+psycopg2://open_analyst:changeme@localhost:5432/open_analyst

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Upload limits (Phase 1 — local development defaults)
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200
UPLOAD_DIR=uploads

# Environment: development | staging | production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
# Public API base URL (accessible from the browser)
VITE_API_BASE_URL=http://localhost:8000
